<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="rail">#14251C</color>
    <!-- Заставка: на Android 12+ систему рисует сама (иконка на фоне окна), ниже — обычный фон.
         Без неё при запуске на секунду мелькал пустой тёмный прямоугольник. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_logo</item>
        <item name="android:windowBackground">@color/rail</item>
        <item name="android:statusBarColor">@color/rail</item>
        <item name="android:navigationBarColor">@color/rail</item>
        <item name="android:colorAccent">#2BB36A</item>
    </style>
</resources>
