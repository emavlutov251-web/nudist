# Настройки для docker compose. Скопируйте в .env и заполните. Файл .env в git не попадает.

# Адрес сервера. Без своего домена подойдёт бесплатный вида 203-0-113-7.sslip.io (IP через дефисы).
DOMAIN=203-0-113-7.sslip.io
# Публичный IP сервера (нужен для звонков).
PUBLIC_IP=203.0.113.7
# Любая длинная случайная строка: openssl rand -hex 24
TURN_SECRET=замените-на-случайную-строку

# Кто становится владельцем (id пользователей через запятую). Пусто — первым владельцем будет первый зарегистрированный.
#OWNERS=
# Максимальный размер одного файла, МБ.
#MAX_UPLOAD_MB=95

# Файлы в S3-хранилище (не обязательно). Без него файлы лежат в томе nudist-data.
#S3_ENDPOINT=https://s3.cloud.ru
#S3_REGION=ru-central-1
#S3_BUCKET=
#S3_KEY_ID=
#S3_SECRET=

# Перед сервером стоит прокси? Обычно настраивать не нужно (см. README, «Защита и уборка файлов»): off | число прокси | cloudflare
#TRUST_PROXY=
# Сколько файлов и мегабайт в час можно загрузить с одного аккаунта
#UPLOADS_PER_HOUR=200
#UPLOAD_MB_PER_HOUR=1024
